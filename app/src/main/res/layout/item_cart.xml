<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <CheckBox
            android:id="@+id/cbSelect"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:buttonTint="#F4D5A5"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardImage"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_toEndOf="@id/cbSelect"
            android:layout_marginStart="8dp"
            android:layout_centerVertical="true"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@android:color/white">
            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="4dp"
                tools:src="@drawable/img_chair"/>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/cardImage"
            android:layout_marginStart="14dp"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="1"
                android:textColor="#1A1A1A"
                android:textSize="15sp"
                tools:text="Product's name" />

            <TextView
                android:id="@+id/tvProductPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="$172.00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#EE4D2D"
                android:layout_marginTop="4dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvProductVariant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_variant_selector"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    tools:text="Color" />

                <LinearLayout
                    android:id="@+id/layoutStepper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:id="@+id/btnMinus"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:text="−"
                        android:textSize="18sp"
                        android:textColor="#555555"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"/>

                    <TextView
                        android:id="@+id/tvQuantity"
                        android:layout_width="26dp"
                        android:layout_height="24dp"
                        android:gravity="center"
                        tools:text="1"
                        android:textSize="13sp"
                        android:textColor="#1A1A1A"
                        android:background="@drawable/bg_quantity_box"
                        android:layout_marginHorizontal="0dp"/>

                    <TextView
                        android:id="@+id/btnPlus"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:text="+"
                        android:textSize="18sp"
                        android:textColor="#555555"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvQuantityFixed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textColor="#1A1A1A"
                    android:textSize="14sp"
                    android:textStyle="normal"
                    android:visibility="gone"
                    tools:text="x1" />

            </RelativeLayout>
        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>
