<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/activity_order_success.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2EDE8"
    android:paddingHorizontal="24dp">

    <!-- Spacer top -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Confetti + badge -->
    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center_horizontal">

        <ImageView
            android:id="@+id/ivConfetti"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_confetti"
            android:scaleType="fitXY"/>

        <ImageView
            android:id="@+id/ivSuccessBadge"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_success_badge"/>
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Order Successful!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginTop="28dp"/>

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="You have successfully made order"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginTop="8dp"/>

    <!-- Spacer bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- View Order -->
    <Button
        android:id="@+id/btnViewOrder"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="View Order"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/bg_button_black"
        android:stateListAnimator="@null"
        android:layout_marginBottom="12dp"/>

    <!-- Back to Home -->
    <Button
        android:id="@+id/btnBackToHome"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Back to home"
        android:textSize="16sp"
        android:textColor="#1A1A1A"
        android:background="@drawable/bg_button_outline"
        android:stateListAnimator="@null"
        android:layout_marginBottom="32dp"/>

</LinearLayout>