<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/onboarding"
    tools:context=".authentication.VerificationActivity">

    <LinearLayout
        android:id="@+id/verificationContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:background="@drawable/bg_login_container"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/back"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_left"
                app:tint="#685047" />

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/playfair_display"
                android:text="@string/str_verification"
                android:textColor="#685047"
                android:textSize="32sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/txtInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="@string/str_verify_email_hint"
            android:textColor="#685047"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtContactInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/str_example_email"
            android:textColor="#685047"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/otpLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/otp1"
                android:layout_width="40dp"
                android:layout_height="45dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_edittext_pill"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="#685047"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:ignore="Autofill,LabelFor" />

            <EditText
                android:id="@+id/otp2"
                android:layout_width="40dp"
                android:layout_height="45dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_edittext_pill"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="#685047"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:ignore="Autofill,LabelFor" />

            <EditText
                android:id="@+id/otp3"
                android:layout_width="40dp"
                android:layout_height="45dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_edittext_pill"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="#685047"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:ignore="Autofill,LabelFor" />

            <EditText
                android:id="@+id/otp4"
                android:layout_width="40dp"
                android:layout_height="45dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_edittext_pill"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="#685047"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:ignore="Autofill,LabelFor" />

            <EditText
                android:id="@+id/otp5"
                android:layout_width="40dp"
                android:layout_height="45dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_edittext_pill"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="#685047"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:ignore="Autofill,LabelFor" />

            <EditText
                android:id="@+id/otp6"
                android:layout_width="40dp"
                android:layout_height="45dp"
                android:layout_margin="4dp"
                android:background="@drawable/bg_edittext_pill"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="#685047"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:ignore="Autofill,LabelFor" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinue"
            android:layout_width="300dp"
            android:layout_height="29dp"
            android:layout_marginTop="-20dp"
            android:layout_marginBottom="15dp"
            android:background="@android:color/transparent"
            android:text="@string/str_continue"
            android:textAllCaps="false"
            android:textColor="#685047"
            android:textSize="28sp"
            android:textStyle="bold|italic" />

        <TextView
            android:id="@+id/txtBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_back_login"
            android:textColor="#F2F0EF"
            android:textSize="16sp"
            android:textStyle="bold|italic"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
