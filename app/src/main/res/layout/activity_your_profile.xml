<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: nút Back + tiêu đề -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:src="@drawable/arrow"
                android:background="@null"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/back"
                app:tint="#111111" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/your_profile"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#111111"
                android:layout_centerInParent="true" />

        </RelativeLayout>

        <!-- Đường kẻ dưới title -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="24dp"/>

        <!-- Avatar (chỉ xem) -->
        <FrameLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="32dp">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/icon_account_circle"
                android:scaleType="centerCrop"/>

            <!-- Badge camera góc dưới phải -->
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/icon_photo_camera"
                android:background="@drawable/bg_circle_camera"
                android:padding="4dp"/>
        </FrameLayout>

        <!-- Full name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/full_name"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvFullName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:hint="@string/bob_smith"
            android:textColor="@color/black"
            android:textColorHint="#BBBBBB"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_field_outline"
            android:layout_marginBottom="16dp"/>

        <!-- Phone number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/phone_number"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:layout_marginBottom="6dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_field_outline">

            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:hint="@string/_1_800_2738_9700"
                android:textColor="@color/black"
                android:textColorHint="#BBBBBB"
                android:paddingStart="14dp"
                android:paddingEnd="52dp"/>

            <ImageButton
                android:id="@+id/btnTogglePhone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_eye_off"
                android:background="@null"
                android:padding="8dp"
                android:contentDescription="Toggle phone visibility"/>

        </RelativeLayout>

        <!-- Email Address -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/email_address"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:layout_marginBottom="6dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_field_outline">

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:hint="@string/bob_smith_gmail_com"
                android:textColor="#111111"
                android:textColorHint="#BBBBBB"
                android:paddingStart="14dp"
                android:paddingEnd="52dp"/>

            <ImageButton
                android:id="@+id/btnToggleEmail"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_eye_off"
                android:background="@null"
                android:padding="8dp"
                android:contentDescription="Toggle email visibility"/>

        </RelativeLayout>

        <!-- Gender -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gender"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvGender"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:hint="@string/male"
            android:textColor="@color/black"
            android:textColorHint="#BBBBBB"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_field_outline"
            android:layout_marginBottom="16dp"/>

        <!-- Date of birth -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/date_of_birth"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvDob"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:hint="@string/_19_05_2005"
            android:textColor="@color/black"
            android:textColorHint="#BBBBBB"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_field_outline"
            android:layout_marginBottom="32dp"/>

        <!-- Nút Edit -->
        <Button
            android:id="@+id/btnEdit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/edit"
            android:backgroundTint="@color/black"
            android:textColor="#FFFFFF"
            android:textSize="16sp"/>

    </LinearLayout>
</ScrollView>