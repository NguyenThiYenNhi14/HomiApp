<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/bg_intro_card.xml -->
<!-- Card trắng với viền trái đen -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background trắng -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pp_white" />
            <stroke android:width="1dp" android:color="@color/pp_divider" />
        </shape>
    </item>
    <!-- Viền trái đen 3dp -->
    <item android:right="716dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pp_black" />
        </shape>
    </item>
</layer-list>